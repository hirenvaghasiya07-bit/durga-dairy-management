{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durga-dairy",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "durga-dairy-db",
      "database_id": "80660686-d0e8-4555-b9e0-4b97da4e908f"
    }
  ],
  "vars": {
    "SESSION_SECRET": "CHANGE_THIS_BEFORE_PRODUCTION"
  }
}
