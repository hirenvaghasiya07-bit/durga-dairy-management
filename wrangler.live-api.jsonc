{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durga-dairy-live-api",
  "main": "cloudflare/live-api-worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "durga-dairy-db",
      "database_id": "80660686-d0e8-4555-b9e0-4b97da4e908f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BACKUP_KV",
      "id": "f97281a2259949698c4c7b146a83e2d3"
    }
  ],
  "observability": { "enabled": true }
}
